# Copy to .env.local and fill in. Only RESEND_API_KEY is required — without it
# the booking form tells visitors to phone instead. The two Google variables are
# optional: without them the reviews section falls back to a link, and the map
# on /over-ons needs no key at all.


# --- Booking form ----------------------------------------------------------

# Resend API key, from https://resend.com. Server-side only — do not prefix
# with NEXT_PUBLIC_. Without it a submitted aanvraag goes nowhere and the form
# says so.
RESEND_API_KEY=

# Who receives the aanvraag. Leave empty in production: it then goes to the
# address in content.yml, which is the one the salon actually reads. Set it
# while testing to send the mail to yourself instead.
RESERVATION_TO=

# The sender address. Leave empty and the mail goes out over Resend's shared
# onboarding@resend.dev, which works without setting up DNS but can only
# deliver to the Resend account's own address — enough to test, not to go live.
# Once hiamsterdamkapsalon.nl is verified in Resend, set this to something like
# "Kapsalon Hi Amsterdam <afspraken@hiamsterdamkapsalon.nl>".
RESERVATION_FROM=


# --- Google ----------------------------------------------------------------

# Places API (New) key for the Google reviews on /over-ons. Server-side only —
# do not prefix with NEXT_PUBLIC_. Enable: "Places API (New)".
GOOGLE_PLACES_API_KEY=

# The salon's Google place ID, e.g. ChIJ... Look it up at
# https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=
