# Copy to .env.local and fill in. Optional: without it the reviews section falls
# back to a placeholder instead of breaking. The map on /over-ons needs no key —
# it uses the keyless Google Maps embed.

# Places API (New) key for the Google reviews on /over-ons. Server-side only —
# do not prefix with NEXT_PUBLIC_. Enable: "Places API (New)".
GOOGLE_PLACES_API_KEY=

# The salon's Google place ID, e.g. ChIJ... Look it up at
# https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=
